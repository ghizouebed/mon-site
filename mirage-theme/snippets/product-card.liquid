{%- assign card_product = product -%}
{%- assign first_available_variant = card_product.first_available_variant -%}

<div class="product-card product-card--{{ settings.product_card_style }}">
  <a href="{{ card_product.url }}" class="product-card__link" aria-label="{{ card_product.title }}">

    <!-- Image -->
    <div class="product-card__media">
      {%- if card_product.featured_image != blank -%}
        <img
          src="{{ card_product.featured_image | image_url: width: 600 }}"
          alt="{{ card_product.featured_image.alt | default: card_product.title | escape }}"
          width="600"
          height="600"
          loading="lazy"
          class="product-card__img"
        >
        {%- if card_product.images.size > 1 -%}
          <img
            src="{{ card_product.images[1] | image_url: width: 600 }}"
            alt="{{ card_product.title | escape }}"
            width="600"
            height="600"
            loading="lazy"
            class="product-card__img product-card__img--hover"
          >
        {%- endif -%}
      {%- else -%}
        <div class="product-card__img-placeholder">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}

      <!-- Badges -->
      <div class="product-card__badges">
        {%- if card_product.available == false -%}
          <span class="product-badge product-badge--sold-out">Rupture de stock</span>
        {%- elsif card_product.compare_at_price > card_product.price and card_product.available -%}
          {%- assign saving_pct = card_product.compare_at_price | minus: card_product.price | times: 100 | divided_by: card_product.compare_at_price -%}
          <span class="product-badge product-badge--sale">-{{ saving_pct }}%</span>
        {%- endif -%}
      </div>
    </div>

    <!-- Infos -->
    <div class="product-card__body">
      <p class="product-card__vendor">{{ card_product.vendor }}</p>
      <h3 class="product-card__title">{{ card_product.title }}</h3>
      <div class="product-card__price">
        {%- if card_product.compare_at_price > card_product.price -%}
          <span class="price price--sale">{{ card_product.price | money }}</span>
          <span class="price price--compare">{{ card_product.compare_at_price | money }}</span>
        {%- else -%}
          <span class="price">{{ card_product.price | money }}</span>
        {%- endif -%}
      </div>
    </div>

  </a>

  <!-- Bouton ajout rapide -->
  {%- if settings.enable_quick_add and card_product.available -%}
    {%- if card_product.has_only_default_variant -%}
      <form action="{{ routes.cart_add_url }}" method="post" class="product-card__quick-add">
        <input type="hidden" name="id" value="{{ first_available_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="product-card__add-btn" aria-label="Ajouter {{ card_product.title }} au panier">
          + Ajouter
        </button>
      </form>
    {%- else -%}
      <a href="{{ card_product.url }}" class="product-card__add-btn">Voir le produit</a>
    {%- endif -%}
  {%- endif -%}
</div>
