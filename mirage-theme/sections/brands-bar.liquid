<section class="brands-bar section-padding--sm" style="background-color: {{ section.settings.bg_color }}; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <p class="brands-bar__heading text-center">{{ section.settings.heading }}</p>
    {%- endif -%}
    <div class="brands-bar__track">
      <div class="brands-bar__list">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'brand' -%}
              <div class="brands-bar__item" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 160 }}" alt="{{ block.settings.name }}" width="120" height="40" loading="lazy" style="filter: grayscale(1); opacity: 0.6; transition: all 0.3s; max-height:40px; width:auto; object-fit:contain;">
                {%- else -%}
                  <span class="brands-bar__name">{{ block.settings.name }}</span>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Barre des marques",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Couleur de fond",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre (optionnel)",
      "default": "Nos marques"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Marque",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo de la marque"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nom (si pas de logo)",
          "default": "Bioderma"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barre des marques",
      "blocks": [
        { "type": "brand", "settings": { "name": "Medicube" } },
        { "type": "brand", "settings": { "name": "Bioderma" } },
        { "type": "brand", "settings": { "name": "La Roche-Posay" } },
        { "type": "brand", "settings": { "name": "Vichy" } },
        { "type": "brand", "settings": { "name": "The Ordinary" } },
        { "type": "brand", "settings": { "name": "Skin1004" } },
        { "type": "brand", "settings": { "name": "Clinique" } },
        { "type": "brand", "settings": { "name": "Aroma-Zone" } }
      ]
    }
  ]
}
{% endschema %}
