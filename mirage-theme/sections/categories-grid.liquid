<section class="categories-grid section-padding">
  <div class="container">

    {%- if section.settings.heading != blank -%}
      <div class="section-header text-center">
        <h2 class="section-header__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="section-header__text">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="categories-grid__items">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'category' -%}
            <a href="{{ block.settings.url }}" class="category-card" {{ block.shopify_attributes }}>
              <div class="category-card__image-wrap">
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 600 }}"
                    alt="{{ block.settings.title }}"
                    width="600"
                    height="600"
                    loading="lazy"
                    class="category-card__image"
                  >
                {%- else -%}
                  <div class="category-card__placeholder" style="background-color: {{ block.settings.bg_color }};"></div>
                {%- endif -%}
                <div class="category-card__overlay"></div>
              </div>
              <div class="category-card__content">
                {%- if block.settings.icon != blank -%}
                  <span class="category-card__icon">{{ block.settings.icon }}</span>
                {%- endif -%}
                <h3 class="category-card__title">{{ block.settings.title }}</h3>
                {%- if block.settings.count != blank -%}
                  <span class="category-card__count">{{ block.settings.count }}</span>
                {%- endif -%}
              </div>
            </a>
        {%- endcase -%}
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Grille de catégories",
  "tag": "section",
  "class": "categories-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Nos catégories"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sous-titre"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Catégorie",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Couleur de fond (sans image)",
          "default": "#5A7A8A"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji / Icône",
          "default": "✨"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Nom de la catégorie",
          "default": "Skincare"
        },
        {
          "type": "text",
          "id": "count",
          "label": "Nombre de produits (ex: 24 produits)"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Lien"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grille de catégories",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "icon": "🧴",
            "title": "Skincare",
            "count": "Soins visage & corps"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "💄",
            "title": "Maquillage",
            "count": "Lèvres, yeux, teint"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "✨",
            "title": "Soins complémentaires",
            "count": "Masques, sérums"
          }
        }
      ]
    }
  ]
}
{% endschema %}
