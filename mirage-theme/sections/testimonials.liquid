<section class="testimonials section-padding" style="background-color: {{ section.settings.bg_color }};">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-header text-center">
        <h2 class="section-header__title" style="color: {{ section.settings.text_color }};">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="section-header__text">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="testimonials__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'review' -%}
            <div class="testimonial-card" {{ block.shopify_attributes }}>
              <!-- Étoiles -->
              <div class="testimonial-card__stars" aria-label="{{ block.settings.rating }} étoiles sur 5">
                {%- for i in (1..5) -%}
                  <span class="star{% if i <= block.settings.rating %} star--filled{% endif %}" aria-hidden="true">★</span>
                {%- endfor -%}
              </div>
              <!-- Texte -->
              <p class="testimonial-card__text">"{{ block.settings.text }}"</p>
              <!-- Auteur -->
              <div class="testimonial-card__author">
                {%- if block.settings.avatar != blank -%}
                  <img src="{{ block.settings.avatar | image_url: width: 60 }}" alt="{{ block.settings.name }}" width="48" height="48" loading="lazy" class="testimonial-card__avatar">
                {%- else -%}
                  <div class="testimonial-card__avatar testimonial-card__avatar--initials">
                    {{ block.settings.name | slice: 0, 1 | upcase }}
                  </div>
                {%- endif -%}
                <div>
                  <strong class="testimonial-card__name">{{ block.settings.name }}</strong>
                  {%- if block.settings.product != blank -%}
                    <p class="testimonial-card__product">{{ block.settings.product }}</p>
                  {%- endif -%}
                </div>
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Avis clients",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Couleur de fond",
      "default": "#f9f5f0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du titre",
      "default": "#1a1a1a"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Ce que disent nos clientes"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "Des milliers de femmes font confiance à Mirage Cosmetics"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Note",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Avis",
          "default": "Produits excellents, je les recommande à toutes mes amies !"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Prénom",
          "default": "Yasmine"
        },
        {
          "type": "text",
          "id": "product",
          "label": "Produit acheté (optionnel)"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Photo (optionnel)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Avis clients",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "text": "Les produits Medicube ont complètement transformé ma peau. Ma routine skincare n'a jamais été aussi efficace !",
            "name": "Yasmine B.",
            "product": "Retinol NMN Boosting Serum"
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "text": "Livraison super rapide à Oran, produits authentiques et bien emballés. Je recommande vivement Mirage Cosmetics !",
            "name": "Sara K.",
            "product": "La Roche-Posay Anthelios"
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "text": "Enfin une boutique à Oran avec des produits de qualité internationale. Le sérum The Ordinary Niacinamide est incroyable pour ce prix.",
            "name": "Nadia M.",
            "product": "The Ordinary Niacinamide 10%"
          }
        }
      ]
    }
  ]
}
{% endschema %}
