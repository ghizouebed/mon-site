<section class="trust-badges section-padding--sm" style="background-color: {{ section.settings.bg_color }};">
  <div class="container">
    <div class="trust-badges__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'badge' -%}
            <div class="trust-badge" {{ block.shopify_attributes }}>
              <span class="trust-badge__icon">{{ block.settings.icon }}</span>
              <div class="trust-badge__text">
                <strong class="trust-badge__title" style="color: {{ section.settings.text_color }};">{{ block.settings.title }}</strong>
                {%- if block.settings.text != blank -%}
                  <p class="trust-badge__desc" style="color: {{ section.settings.text_color_light }};">{{ block.settings.text }}</p>
                {%- endif -%}
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Badges de confiance",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Couleur de fond",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du titre",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color_light",
      "label": "Couleur du texte",
      "default": "#666666"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji / Icône",
          "default": "🚚"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Livraison rapide"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "À Oran et environs"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Badges de confiance",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "icon": "🚚",
            "title": "Livraison rapide",
            "text": "À Oran et environs"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "✨",
            "title": "Produits authentiques",
            "text": "100% originaux garantis"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "🔒",
            "title": "Paiement sécurisé",
            "text": "Transactions protégées"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "↩️",
            "title": "Retours faciles",
            "text": "Satisfaite ou remboursée"
          }
        }
      ]
    }
  ]
}
{% endschema %}
