<section class="rich-text section-padding" style="background-color: {{ section.settings.bg_color }};">
  <div class="container">
    <div class="rich-text__inner rich-text__inner--{{ section.settings.width }} text-{{ section.settings.text_align }}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="rich-text__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="rich-text__heading" style="color: {{ section.settings.text_color }};">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.content != blank -%}
        <div class="rich-text__content" style="color: {{ section.settings.text_color }};">{{ section.settings.content }}</div>
      {%- endif -%}
      {%- if section.settings.btn_text != blank -%}
        <a href="{{ section.settings.btn_url }}" class="btn btn--primary">{{ section.settings.btn_text }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Texte enrichi",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Couleur de fond",
      "default": "#f9f5f0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#1a1a1a"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Largeur du contenu",
      "options": [
        { "value": "narrow", "label": "Étroit" },
        { "value": "medium", "label": "Moyen" },
        { "value": "full", "label": "Plein" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alignement",
      "options": [
        { "value": "left", "label": "Gauche" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Accroche"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Notre engagement beauté"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Contenu",
      "default": "<p>Chez Mirage Cosmetics, nous sélectionnons pour vous les meilleurs produits cosmétiques alliant qualité, efficacité et luxe accessible.</p>"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Texte du bouton"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Lien du bouton"
    }
  ],
  "presets": [
    {
      "name": "Texte enrichi"
    }
  ]
}
{% endschema %}
