<section class="page-content section-padding">
  <div class="container">
    <div class="page-content__inner">
      <h1 class="page-title">{{ page.title }}</h1>
      {%- if page.content != blank -%}
        <div class="rte page-content__body">{{ page.content }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contenu de page",
  "tag": "section",
  "settings": []
}
{% endschema %}
