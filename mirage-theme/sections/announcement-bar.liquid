{%- if section.settings.show_bar -%}
<div class="announcement-bar" style="background-color: {{ section.settings.color_background }}; color: {{ section.settings.color_text }};">
  <div class="announcement-bar__container">
    <p class="announcement-bar__text">{{ section.settings.text }}</p>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Barre d'annonce",
  "class": "announcement-bar-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_bar",
      "label": "Afficher la barre",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Message",
      "default": "🌸 Livraison gratuite à Oran dès 3000 DA d'achats"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Couleur de fond",
      "default": "#C44B6F"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Couleur du texte",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Barre d'annonce"
    }
  ]
}
{% endschema %}
