{%- assign collection = collections[section.settings.collection] -%}

<section class="featured-collection section-padding">
  <div class="container">

    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="section-header text-{{ section.settings.heading_align }}">
        {%- if section.settings.heading != blank -%}
          <h2 class="section-header__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="section-header__text">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="product-grid product-grid--{{ section.settings.columns_desktop }}">
      {%- if collection != blank -%}
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          {%- render 'product-card', product: product -%}
        {%- else -%}
          {%- for i in (1..section.settings.products_to_show) -%}
            {%- render 'product-card-placeholder' -%}
          {%- endfor -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.products_to_show) -%}
          {%- render 'product-card-placeholder' -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all and collection != blank -%}
      <div class="section-cta text-center">
        <a href="{{ collection.url }}" class="btn btn--secondary">
          {{ section.settings.view_all_text }}
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Collection mise en avant",
  "tag": "section",
  "class": "featured-collection-section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Nombre de produits",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Colonnes (desktop)",
      "options": [
        { "value": "2", "label": "2 colonnes" },
        { "value": "3", "label": "3 colonnes" },
        { "value": "4", "label": "4 colonnes" }
      ],
      "default": "4"
    },
    {
      "type": "header",
      "content": "Texte"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Notre collection"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sous-titre"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Alignement du titre",
      "options": [
        { "value": "left", "label": "Gauche" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Afficher le bouton \"Voir tout\"",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "Texte du bouton",
      "default": "Voir toute la collection"
    }
  ],
  "presets": [
    {
      "name": "Collection mise en avant",
      "settings": {
        "heading": "Nos bestsellers",
        "subheading": "Les produits préférés de nos clientes"
      }
    }
  ]
}
{% endschema %}
