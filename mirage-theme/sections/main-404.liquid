<section class="error-404 section-padding">
  <div class="container text-center">
    <h1 class="error-404__title">404</h1>
    <h2 class="error-404__subtitle">Page introuvable</h2>
    <p class="error-404__text">La page que vous cherchez n'existe pas ou a été déplacée.</p>
    <a href="{{ routes.root_url }}" class="btn btn--primary">Retour à l'accueil</a>
  </div>
</section>

{% schema %}
{
  "name": "Page 404",
  "tag": "section",
  "settings": []
}
{% endschema %}
