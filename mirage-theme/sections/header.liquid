<header class="site-header{% if settings.sticky_header %} site-header--sticky{% endif %}" role="banner">
  <div class="site-header__container">

    <!-- Menu burger mobile -->
    <button class="site-header__menu-toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="Ouvrir le menu">
      <span class="burger-icon"></span>
    </button>

    <!-- Logo -->
    <div class="site-header__logo">
      <a href="{{ routes.root_url }}" class="site-header__logo-link" aria-label="{{ shop.name }}">
        {%- if settings.logo != blank -%}
          <img
            src="{{ settings.logo | image_url: width: settings.logo_width }}"
            alt="{{ shop.name }}"
            width="{{ settings.logo_width }}"
            height="auto"
            loading="eager"
            class="site-header__logo-img"
          >
        {%- else -%}
          <img
            src="{{ 'mirage-logo.svg' | asset_url }}"
            alt="{{ shop.name }}"
            width="200"
            height="60"
            loading="eager"
            class="site-header__logo-img site-header__logo-img--svg"
          >
        {%- endif -%}
      </a>
    </div>

    <!-- Navigation principale -->
    <nav class="site-header__nav" id="main-nav" role="navigation" aria-label="Navigation principale">
      {%- if section.settings.menu != blank -%}
        {%- assign main_menu = linklists[section.settings.menu] -%}
        <ul class="nav-list" role="list">
          {%- for link in main_menu.links -%}
            <li class="nav-list__item{% if link.links.size > 0 %} nav-list__item--has-dropdown{% endif %}">
              <a href="{{ link.url }}" class="nav-list__link{% if link.active %} nav-list__link--active{% endif %}" {% if link.links.size > 0 %}aria-expanded="false" aria-haspopup="true"{% endif %}>
                {{ link.title }}
                {%- if link.links.size > 0 -%}
                  <span class="nav-list__chevron" aria-hidden="true">▾</span>
                {%- endif -%}
              </a>
              {%- if link.links.size > 0 -%}
                <ul class="nav-dropdown" role="list">
                  {%- for child_link in link.links -%}
                    <li>
                      <a href="{{ child_link.url }}" class="nav-dropdown__link{% if child_link.active %} active{% endif %}">
                        {{ child_link.title }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </nav>

    <!-- Actions (recherche + panier) -->
    <div class="site-header__actions">
      {%- if section.settings.show_search -%}
        <button class="header-icon-btn" aria-label="Rechercher" id="search-toggle">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
          </svg>
        </button>
      {%- endif -%}

      {%- if section.settings.show_cart -%}
        <a href="{{ routes.cart_url }}" class="header-icon-btn cart-icon-btn" aria-label="Panier ({{ cart.item_count }} articles)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          {%- if cart.item_count > 0 -%}
            <span class="cart-count" aria-hidden="true">{{ cart.item_count }}</span>
          {%- endif -%}
        </a>
      {%- endif -%}
    </div>

  </div>

  <!-- Barre de recherche -->
  {%- if section.settings.show_search -%}
    <div class="search-bar" id="search-bar" hidden>
      <div class="search-bar__container">
        <form action="{{ routes.search_url }}" method="get" role="search">
          <input type="hidden" name="type" value="product">
          <input
            type="search"
            name="q"
            placeholder="Rechercher un produit..."
            class="search-bar__input"
            aria-label="Rechercher"
          >
          <button type="submit" class="search-bar__submit" aria-label="Lancer la recherche">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
            </svg>
          </button>
        </form>
        <button class="search-bar__close" id="search-close" aria-label="Fermer la recherche">✕</button>
      </div>
    </div>
  {%- endif -%}

  <!-- Menu mobile -->
  <div class="mobile-menu" id="mobile-menu" hidden>
    <div class="mobile-menu__header">
      <span class="mobile-menu__title">Menu</span>
      <button class="mobile-menu__close" aria-label="Fermer le menu">✕</button>
    </div>
    {%- if section.settings.menu != blank -%}
      {%- assign main_menu = linklists[section.settings.menu] -%}
      <ul class="mobile-nav-list" role="list">
        {%- for link in main_menu.links -%}
          <li>
            <a href="{{ link.url }}" class="mobile-nav-list__link{% if link.active %} active{% endif %}">
              {{ link.title }}
            </a>
            {%- if link.links.size > 0 -%}
              <ul class="mobile-nav-sub" role="list">
                {%- for child_link in link.links -%}
                  <li>
                    <a href="{{ child_link.url }}" class="mobile-nav-sub__link{% if child_link.active %} active{% endif %}">
                      {{ child_link.title }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

</header>

{% schema %}
{
  "name": "En-tête",
  "class": "header-section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu principal",
      "default": "main-menu"
    },
    {
      "type": "select",
      "id": "logo_position",
      "label": "Position du logo",
      "options": [
        { "value": "left", "label": "Gauche" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Afficher la recherche",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Afficher le panier",
      "default": true
    }
  ]
}
{% endschema %}
