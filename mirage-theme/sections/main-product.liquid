{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign featured_image = current_variant.featured_image | default: product.featured_image -%}

<section class="product-page section-padding">
  <div class="container">
    <div class="product-layout">

      <!-- Images produit -->
      <div class="product-media">
        <div class="product-media__main">
          {%- if product.images.size > 0 -%}
            <div class="product-media__featured" id="product-featured-image">
              {%- if featured_image != blank -%}
                <img
                  src="{{ featured_image | image_url: width: 800 }}"
                  alt="{{ featured_image.alt | default: product.title }}"
                  width="800"
                  height="800"
                  loading="eager"
                  id="main-product-image"
                  class="product-media__img"
                >
              {%- endif -%}
            </div>
            {%- if product.images.size > 1 -%}
              <div class="product-media__thumbnails">
                {%- for image in product.images limit: 6 -%}
                  <button class="product-media__thumb{% if forloop.first %} active{% endif %}" data-src="{{ image | image_url: width: 800 }}" aria-label="{{ image.alt | default: product.title }}">
                    <img src="{{ image | image_url: width: 120 }}" alt="{{ image.alt | default: product.title }}" width="120" height="120" loading="lazy">
                  </button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          {%- else -%}
            <div class="product-media__placeholder">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>
      </div>

      <!-- Infos produit -->
      <div class="product-info">

        <!-- Breadcrumb -->
        <nav class="breadcrumb" aria-label="Fil d'Ariane">
          <a href="{{ routes.root_url }}">Accueil</a>
          <span aria-hidden="true"> / </span>
          {%- if product.collections.first -%}
            <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
            <span aria-hidden="true"> / </span>
          {%- endif -%}
          <span aria-current="page">{{ product.title }}</span>
        </nav>

        <!-- Titre -->
        <h1 class="product-info__title">{{ product.title }}</h1>

        <!-- Prix -->
        <div class="product-info__price" id="product-price">
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="price price--sale">{{ current_variant.price | money }}</span>
            <span class="price price--compare">{{ current_variant.compare_at_price | money }}</span>
            <span class="price-badge">
              -{%- assign saving = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price -%}
              {{ saving }}%
            </span>
          {%- else -%}
            <span class="price">{{ current_variant.price | money }}</span>
          {%- endif -%}
        </div>

        <!-- Formulaire d'ajout au panier -->
        {%- form 'product', product, id: 'product-form', novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" id="variant-id">

          <!-- Variantes -->
          {%- unless product.has_only_default_variant -%}
            <div class="product-variants">
              {%- for option in product.options_with_values -%}
                <div class="product-variant-group">
                  <label class="product-variant-group__label">
                    {{ option.name }}:
                    <span class="product-variant-group__selected" id="selected-{{ option.name | handleize }}">{{ option.selected_value }}</span>
                  </label>
                  <div class="product-variant-group__options">
                    {%- for value in option.values -%}
                      <button
                        type="button"
                        class="variant-btn{% if option.selected_value == value %} variant-btn--selected{% endif %}"
                        data-option-index="{{ forloop.parentloop.index0 }}"
                        data-option-value="{{ value | escape }}"
                        aria-pressed="{{ option.selected_value == value }}"
                      >
                        {{ value }}
                      </button>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <!-- Quantité -->
          <div class="product-quantity">
            <label for="product-qty" class="product-quantity__label">Quantité</label>
            <div class="quantity-selector">
              <button type="button" class="quantity-selector__btn" data-action="minus" aria-label="Diminuer la quantité">−</button>
              <input type="number" id="product-qty" name="quantity" value="1" min="1" class="quantity-selector__input" aria-label="Quantité">
              <button type="button" class="quantity-selector__btn" data-action="plus" aria-label="Augmenter la quantité">+</button>
            </div>
          </div>

          <!-- Bouton ajouter au panier -->
          <div class="product-actions">
            {%- if current_variant.available -%}
              <button type="submit" name="add" class="btn btn--primary btn--full btn--add-to-cart">
                <span>Ajouter au panier</span>
              </button>
            {%- else -%}
              <button type="button" class="btn btn--disabled btn--full" disabled>
                Rupture de stock
              </button>
            {%- endif -%}
          </div>

        {%- endform -%}

        <!-- Description courte -->
        {%- if product.description != blank -%}
          <div class="product-info__description">
            <h3 class="product-info__desc-title">Description</h3>
            <div class="rte">{{ product.description }}</div>
          </div>
        {%- endif -%}

        <!-- Tags / badges -->
        {%- if product.tags.size > 0 -%}
          <div class="product-tags">
            {%- for tag in product.tags -%}
              <a href="{{ routes.collections_url }}/{{ tag | handle }}" class="product-tag">{{ tag }}</a>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <!-- Partage -->
        <div class="product-share">
          <span class="product-share__label">Partager :</span>
          <a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url }}{{ product.url }}" target="_blank" rel="noopener" class="product-share__link" aria-label="Partager sur Facebook">Facebook</a>
          <a href="https://wa.me/?text={{ product.title | url_encode }}%20{{ shop.url }}{{ product.url }}" target="_blank" rel="noopener" class="product-share__link" aria-label="Partager sur WhatsApp">WhatsApp</a>
        </div>

      </div>
    </div>
  </div>
</section>

<!-- Produits liés -->
{%- if section.settings.show_related -%}
  {%- assign related_products = product.collections.first.products -%}
  {%- if related_products.size > 1 -%}
    <section class="related-products section-padding">
      <div class="container">
        <h2 class="section-header__title text-center">{{ section.settings.related_title }}</h2>
        <div class="product-grid product-grid--4">
          {%- for related_product in related_products limit: 4 -%}
            {%- unless related_product.id == product.id -%}
              {%- render 'product-card', product: related_product -%}
            {%- endunless -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Page produit",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_related",
      "label": "Afficher les produits liés",
      "default": true
    },
    {
      "type": "text",
      "id": "related_title",
      "label": "Titre des produits liés",
      "default": "Vous aimerez aussi"
    }
  ]
}
{% endschema %}
